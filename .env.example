# 复制后按需修改
# server/.env / client/.env 可分别覆盖
PORT=3001
CORS_ORIGIN=http://localhost:5173
GITHUB_TOKEN=
COPILOT_MODEL=gpt-5

# 模型通道：copilot | deepseek（BYOK，另需 DEEPSEEK_API_KEY，见 server/.env.example）
COPILOT_PROVIDER=copilot
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 会话 idle 超时秒数（0=关闭；K8s 建议 1800）
COPILOT_SESSION_IDLE_TIMEOUT=0

# 本地开发显式打开（生产默认全关，见 server/.env.example / k8s/deployment.yaml）
COPILOT_MCP_FILESYSTEM=true
COPILOT_ALLOW_INLINE_MCP_LOCAL=false
COPILOT_ALLOW_INLINE_MCP_HTTP=true
