# Copilot Runtime 镜像（headless CLI server；官方无预构建镜像，自建）
# 构建：docker build -f Dockerfile.copilot-runtime -t copilot-runtime:1.0.14 .
# 版本：docker build -f Dockerfile.copilot-runtime --build-arg COPILOT_VERSION=1.0.14 .
FROM debian:bookworm-slim

ARG COPILOT_VERSION=1.0.14
ARG TARGETARCH

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     ca-certificates \
     wget \
  && rm -rf /var/lib/apt/lists/*

RUN ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" \
  && case "${ARCH}" in \
       amd64) COPILOT_ARCH="x64" ;; \
       arm64) COPILOT_ARCH="arm64" ;; \
       *) echo "Unsupported architecture: ${ARCH}"; exit 1 ;; \
     esac \
  && wget -q \
     "https://github.com/github/copilot-cli/releases/download/v${COPILOT_VERSION}/copilot-linux-${COPILOT_ARCH}.tar.gz" \
  && tar -xzf "copilot-linux-${COPILOT_ARCH}.tar.gz" \
  && mv copilot /usr/local/bin/copilot \
  && rm "copilot-linux-${COPILOT_ARCH}.tar.gz" \
  && copilot --version

# 会话持久化目录（SDK forUri 时 baseDirectory 被忽略，COPILOT_HOME 必须配在 runtime 这边）
ENV COPILOT_HOME=/var/lib/copilot

RUN mkdir -p /var/lib/copilot \
  && chmod 755 /var/lib/copilot

VOLUME ["/var/lib/copilot"]

EXPOSE 4321

# 默认 headless + 仅 loopback（sidecar 同 Pod 经 127.0.0.1:4321 连接；跨 Pod 才需 --host 0.0.0.0）
ENTRYPOINT ["copilot", "--headless", "--host", "127.0.0.1", "--port", "4321"]
