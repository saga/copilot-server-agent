# Server env — 复制为 server/.env 后填入
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Copilot SDK auth: 留空则使用 copilot CLI 已登录用户；CI/服务器模式可填 GITHUB_TOKEN
GITHUB_TOKEN=
COPILOT_MODEL=gpt-5

# --- Workspace 隔离：每 session 一独立目录（本地默认系统临时目录下；K8s 设 /workspaces） ---
# COPILOT_WORKSPACE_ROOT=/workspaces

# --- Runtime 连接：留空=SDK 自己拉起本地 runtime；K8s sidecar 填 http://127.0.0.1:4321 ---
# COPILOT_RUNTIME_URL=http://127.0.0.1:4321
# --- 本地 runtime 数据目录（透传 COPILOT_HOME；连外部 runtime 时配在 runtime 那边） ---
# COPILOT_HOME=/var/lib/copilot

# --- 模型通道：copilot（默认，走 GitHub 认证）| deepseek（BYOK，自带 key） ---
COPILOT_PROVIDER=copilot

# --- DeepSeek BYOK（COPILOT_PROVIDER=deepseek 时必填；key 只放 .env，不进代码） ---
# 去 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
# 可选：deepseek-v4-flash（默认）| deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- 会话持久化：无活动超时秒数（0=关闭，会话常驻直到断开/删除；K8s 建议 1800） ---
COPILOT_SESSION_IDLE_TIMEOUT=0

# --- 技能目录 allowlist（逗号分隔；留空=本地不限制；生产必须配） ---
# COPILOT_SKILL_ROOTS=/opt/copilot/skills,/workspace/skills

# --- 管理接口令牌（留空=本地不设防；生产设置后 /api/debug、/api/hooks 需带 x-admin-token） ---
# COPILOT_ADMIN_TOKEN=

# --- MCP ---
# filesystem 预设开关（默认关；开则必须配 COPILOT_MCP_FS_DIR，禁挂整个 repo）
COPILOT_MCP_FILESYSTEM=false
# COPILOT_MCP_FS_DIR=/workspace
# 运维预置额外 MCP（JSON），如 {"github":{"type":"http","url":"https://...","headers":{"Authorization":"Bearer ..."}}}
# COPILOT_MCP_SERVERS=
# 内联 local MCP 安全门（默认关=拒绝前端自带 command；仅信任前端可开）
COPILOT_ALLOW_INLINE_MCP_LOCAL=false
# 内联 http MCP 开关（默认关；生产只用 COPILOT_MCP_SERVERS 预置）
COPILOT_ALLOW_INLINE_MCP_HTTP=false

# --- 调试（对应官方 debugging 文档） ---
# SDK 日志级别：none | error | warning | info | debug | all（留空=SDK 默认；填错启动即报错）
COPILOT_LOG_LEVEL=
# CLI 日志目录（透传 --log-dir 给 CLI）
# COPILOT_LOG_DIR=./logs/copilot
# CLI 路径（copilot 不在 PATH 时填完整路径）
# COPILOT_CLI_PATH=/opt/homebrew/bin/copilot
