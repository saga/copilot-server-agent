# Server env — 复制为 server/.env 后填入
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Copilot SDK auth: 留空则使用 copilot CLI 已登录用户；CI/服务器模式可填 GITHUB_TOKEN
GITHUB_TOKEN=
COPILOT_MODEL=gpt-5
COPILOT_WORKING_DIRECTORY=

# --- 模型通道：copilot（默认，走 GitHub 认证）| deepseek（BYOK，自带 key） ---
COPILOT_PROVIDER=copilot

# --- DeepSeek BYOK（COPILOT_PROVIDER=deepseek 时必填；key 只放 .env，不进代码） ---
# 去 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
# 可选：deepseek-v4-flash（默认）| deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- 会话持久化：无活动超时秒数（0=关闭，会话常驻直到断开/删除） ---
COPILOT_SESSION_IDLE_TIMEOUT=0

# --- MCP ---
# filesystem 预设开关（默认开，授权目录默认仓库根）
COPILOT_MCP_FILESYSTEM=true
# COPILOT_MCP_FS_DIR=/path/to/allowed-dir
# 运维预置额外 MCP（JSON），如 {"github":{"type":"http","url":"https://...","headers":{"Authorization":"Bearer ..."}}}
# COPILOT_MCP_SERVERS=
# 内联 local MCP 安全门（默认关=拒绝前端自带 command；仅信任前端可开）
COPILOT_ALLOW_INLINE_MCP_LOCAL=false
# 内联 http MCP 开关（默认开）
COPILOT_ALLOW_INLINE_MCP_HTTP=true
